# Copy to backend/.env for local development. Every value here is optional; defaults are shown.

# SQLite file (the Docker image uses sqlite:////data/route53.db)
DATABASE_URL=sqlite:///./data/route53.db

# Login session lifetime in hours
SESSION_TTL_HOURS=8

# Session cookie "Secure" flag. The code default is true (production, HTTPS only).
# Set to false for plain-HTTP local development; browsers other than Chrome/Firefox on
# localhost will not store a Secure cookie over http://.
COOKIE_SECURE=false

# Only needed if the browser calls the API directly instead of through the Next.js proxy
CORS_ORIGINS=["http://localhost:3000"]
